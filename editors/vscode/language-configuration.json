{
  "comments": { "lineComment": "#", "blockComment": ["/*", "*/"] },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" }, { "open": "[", "close": "]" }, { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }, { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(func|async func|class|struct|interface|enum|if|elif|else|for|while|try|catch|finally|match)\\b.*:\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(elif|else|catch|finally)\\b"
  },
  "onEnterRules": [{ "beforeText": ":\\s*(#.*)?$", "action": { "indent": "indent" } }],
  "folding": { "offSide": true }
}
