func page():
    return dom.parse("<!DOCTYPE html><title>Essai</title><ul id=l><li class=a>1</li><li>2</li></ul><p id=p>Bonjour <b>le</b> monde</p>")

func t_tree():
    doc := page()
    assert_eq(doc.title(), "Essai")
    ul := doc.get_element_by_id("l")
    assert_eq(ul.child_element_count(), 2)
    assert_eq(ul.first_element_child().text_content(), "1")
    li := doc.create_element("LI")
    assert_eq(li.tag_name, "LI")
    assert_eq(li.local_name, "li")
    li.set_text_content("3")
    ul.append_child(li)
    kids := ul.child_nodes()
    assert_eq(kids.length(), 3)
    ul.insert_before(doc.create_text_node("x"), ul.first_child())
    assert_eq(kids.length(), 4)
    assert_eq(li.previous_element_sibling().text_content(), "2")
    assert_raises(() => li.append_child(ul), "HierarchyRequestError")
    assert_raises(() => ul.remove_child(doc.body()), "NotFoundError")
    assert_raises(() => doc.append_child(doc.create_element("div")), "HierarchyRequestError")
    assert_raises(() => doc.create_element("1x"), "InvalidCharacterError")
    frag := doc.create_document_fragment()
    frag.append_child(doc.create_element("li"))
    frag.append_child(doc.create_element("li"))
    ul.append_child(frag)
    assert_eq(ul.child_element_count(), 5)
    assert_eq(frag.child_nodes().length(), 0)
    li.before(["avant", doc.create_element("hr")])
    assert_eq(li.previous_sibling().local_name, "hr")
    li.replace_with("remplacé")
    assert_false(ul.contains(li))
    assert_true(doc.contains(ul))
    p := doc.get_element_by_id("p")
    assert_eq(ul.compare_document_position(p), nd.DOCUMENT_POSITION_FOLLOWING)
    assert_eq(p.compare_document_position(ul), nd.DOCUMENT_POSITION_PRECEDING)
    assert_eq(doc.body().compare_document_position(ul), nd.DOCUMENT_POSITION_CONTAINED_BY + nd.DOCUMENT_POSITION_FOLLOWING)
    c := ul.clone_node(true)
    assert_true(c.is_equal_node(ul))
    assert_null(c.parent_node)
    assert_false(c.is_connected())
    t := tx.Text("Bonjour le monde")
    p.append_child(t)
    rest := t.split_text(7)
    assert_eq(t.data, "Bonjour")
    assert_eq(rest.data, " le monde")
    assert_eq(t.whole_text(), " mondeBonjour le monde")
    p.normalize()
    assert_eq(p.text_content(), "Bonjour le mondeBonjour le monde")

testing.test("arbre de nœuds", t_tree)

func t_attributes_html():
    doc := page()
    a := doc.create_element("a")
    a.set_attribute("HREF", "/aide")
    assert_eq(a.get_attribute("href"), "/aide")
    a.class_list.add(["lien", "actif"])
    assert_true(a.class_list.toggle("ouvert"))
    assert_false(a.class_list.toggle("ouvert"))
    assert_true(a.class_list.replace("actif", "inactif"))
    assert_eq(a.class_name(), "lien inactif")
    assert_raises(() => a.class_list.add("a b"), "InvalidCharacterError")
    a.dataset.set("suiviMenu", "1")
    assert_eq(a.get_attribute("data-suivi-menu"), "1")
    assert_eq(a.dataset.keys(), ["suiviMenu"])
    a.style.set_property("color", "red")
    a.style.set("font_size", "12px")
    assert_eq(a.get_attribute("style"), "color: red; font-size: 12px")
    assert_eq(a.style.get_property_value("font-size"), "12px")
    a.style.remove_property("color")
    assert_eq(a.style.css_text(), "font-size: 12px")
    assert_true(a.toggle_attribute("hidden"))
    assert_eq(a.attributes.length(), 5)
    assert_eq(a.attributes.item(0).name, "href")
    assert_raises(() => a.set_attribute("a b", "x"), "InvalidCharacterError")
    a.set_inner_html("Aide <b>en ligne</b> &amp; <!--c-->plus")
    assert_eq(a.inner_html(), "Aide <b>en ligne</b> &amp; <!--c-->plus")
    assert_eq(a.text_content(), "Aide en ligne & plus")
    assert_eq(a.outer_html(), "<a href=\"/aide\" class=\"lien inactif\" data-suivi-menu=\"1\" style=\"font-size: 12px\" hidden=\"\">Aide <b>en ligne</b> &amp; <!--c-->plus</a>")
    ul := doc.get_element_by_id("l")
    ul.insert_adjacent_html("beforeend", "<li>3</li>")
    ul.insert_adjacent_html("beforebegin", "<h2>Liste</h2>")
    assert_eq(ul.previous_element_sibling().local_name, "h2")
    assert_eq(ul.last_element_child().text_content(), "3")
    s := doc.create_element("script")
    s.set_text_content("if (a < b) x()")
    assert_eq(s.outer_html(), "<script>if (a < b) x()</script>")
    br := doc.create_element("br")
    assert_eq(br.outer_html(), "<br>")
    svg := dom.parse("<!DOCTYPE html><svg viewBox='0 0 1 1'><circle r=1></circle></svg>").query_selector("circle")
    assert_eq(svg.namespace_uri, el.SVG_NS)
    p := doc.get_element_by_id("p")
    p.set_outer_html("<div id=q>nouveau</div>")
    assert_null(doc.get_element_by_id("p"))
    assert_eq(doc.get_element_by_id("q").text_content(), "nouveau")
    assert_eq(doc.to_html()[0:60], "<!DOCTYPE html><html><head><title>Essai</title></head><body>")

testing.test("attributs, classes, styles, HTML", t_attributes_html)

func t_selectors():
    doc := dom.parse("<!DOCTYPE html><nav><a class=actif href=/>A</a><a href=/b>B</a></nav><ul><li>1</li><li>2</li><li>3</li></ul><form><input name=x required><input type=checkbox name=c checked></form>")
    assert_eq(doc.query_selector_all("ul li:nth-child(odd)").length(), 2)
    assert_eq(doc.query_selector("nav > a.actif").text_content(), "A")
    li := doc.query_selector("li:last-child")
    assert_true(li.matches("ul > li"))
    assert_eq(li.closest("ul").local_name, "ul")
    assert_eq(doc.get_elements_by_tag_name("li").length(), 3)
    coll := doc.get_elements_by_tag_name("li")
    doc.query_selector("ul").append_child(doc.create_element("li"))
    assert_eq(coll.length(), 4)
    assert_eq(doc.get_elements_by_class_name("actif").length(), 1)
    assert_raises(() => doc.query_selector("a["), "SyntaxError")
    cb := doc.query_selector("input[type=checkbox]")
    assert_true(cb.matches(":checked"))
    cb.set_checked(false)
    assert_false(cb.matches(":checked"))
    assert_true(doc.query_selector("input[name=x]").matches(":invalid"))
    f := doc.query_selector("form")
    assert_eq(f.query_selector_all(":scope > input").length(), 2)
    btn := doc.create_element("button")
    doc.body().append_child(btn)
    btn.focus()
    assert_true(btn.matches(":focus"))
    assert_true(doc.body().matches(":focus-within"))
    assert_eq(sel.specificity("nav > a.actif"), (0, 1, 2))

testing.test("sélecteurs et collections", t_selectors)

func t_events():
    doc := dom.parse("<!DOCTYPE html><div id=o><p id=i><b id=b>x</b></p></div>")
    log := []
    o := doc.get_element_by_id("o")
    i := doc.get_element_by_id("i")
    b := doc.get_element_by_id("b")
    o.add_event_listener("ping", (e) => append(log, "o-capture"), true)
    o.add_event_listener("ping", (e) => append(log, "o-bubble"))
    i.add_event_listener("ping", (e) => append(log, "i-bubble"))
    b.add_event_listener("ping", (e) => append(log, "b-target " + str(e.event_phase)))
    doc.add_event_listener("ping", (e) => append(log, "doc"))
    assert_true(b.dispatch_event(ev.Event("ping", true, true)))
    assert_eq(log, ["o-capture", "b-target 2", "i-bubble", "o-bubble", "doc"])
    log2 := []
    i.add_event_listener("stop", (e) => e.stop_propagation())
    o.add_event_listener("stop", (e) => append(log2, "jamais"))
    b.dispatch_event(ev.Event("stop", true))
    assert_eq(log2, [])
    b.add_event_listener("annule", (e) => e.prevent_default())
    assert_false(b.dispatch_event(ev.Event("annule", true, true)))
    b.add_event_listener("passif", (e) => e.prevent_default(), {"passive": true})
    assert_true(b.dispatch_event(ev.Event("passif", true, true)))
    b.add_event_listener("une", (e) => append(log2, "une"), {"once": true})
    b.dispatch_event(ev.Event("une"))
    b.dispatch_event(ev.Event("une"))
    assert_eq(log2, ["une"])
    e := ev.Event("x")
    path := []
    b.add_event_listener("x", (evt) => append(path, len(evt.composed_path())))
    b.dispatch_event(e)
    assert_eq(path, [6])
    d := []
    evs.delegate(o, "click", "p", (evt, m) => append(d, m.id()))
    evs.click(b)
    assert_eq(d, ["i"])
    got := []
    o.add_event_listener("panier", (evt) => append(got, evt.detail["id"]))
    assert_true(evs.fire(b, "panier", {"id": 42}))
    assert_eq(got, [42])
    k := ke.from_shortcut("Ctrl+Shift+K")
    assert_true(k.ctrl_key and k.shift_key)
    assert_eq(k.key, "K")
    assert_true(ke.matches_shortcut(k, "ctrl+shift+k"))
    assert_eq(ke.code_for("a"), "KeyA")
    m := me.MouseEvent("click", {"client_x": 10, "client_y": 20})
    assert_eq(m.page_x, 10)
    assert_true(m.bubbles)
    assert_eq(pe.PointerEvent("pointerdown", {"pointer_type": "touch"}).pressure, 0.5)
    assert_eq(ie.apply("Bonjour", 7, 7, ie.INSERT_TEXT, " !"), ("Bonjour !", 9))
    assert_eq(ie.apply("un deux", 7, 7, ie.DELETE_WORD_BACKWARD), ("un ", 3))
    b.add_event_listener("err", (evt) => 1 / 0)
    et.clear_reported_errors()
    b.dispatch_event(ev.Event("err"))
    assert_eq(len(et.reported_errors()), 1)
    b.set_event_handler("h", (evt) => false)
    assert_false(b.dispatch_event(ev.Event("h", true, true)))
    assert_raises(() => b.dispatch_event(_dispatched(b)), "InvalidStateError")

func _dispatched(target):
    e := ev.Event("re")
    e.dispatching = true
    return e

testing.test("événements et distribution", t_events)

func t_forms_interaction():
    doc := dom.parse("<!DOCTYPE html><form id=f><label for=q>Q</label><input id=q name=q required minlength=2><input type=checkbox name=c value=oui><input type=radio name=r value=1 checked><input type=radio name=r value=2><select name=s><option value=a>A</option><option value=b>B</option></select><textarea name=t>défaut</textarea><button>OK</button><button type=reset>RAZ</button></form><a href=/x>lien</a><details><summary>Plus</summary>…</details>")
    win := dom.window(doc)
    f := doc.get_element_by_id("f")
    q := doc.get_element_by_id("q")
    submits := []
    f.add_event_listener("submit", (e) => append(submits, e.type))
    invalids := evs.record(q, "invalid")
    evs.click(doc.query_selector("button"))
    assert_eq(len(submits), 0)
    assert_eq(len(invalids), 1)
    assert_eq(q.validation_message(), "Veuillez renseigner ce champ.")
    inputs := evs.record(q, "input")
    evs.type_text(q, "chat")
    assert_eq(q.value(), "chat")
    assert_eq(len(inputs), 4)
    assert_true(doc.active_element() == q)
    evs.click(doc.query_selector("label"))
    assert_true(doc.active_element() == q)
    cb := doc.query_selector("input[type=checkbox]")
    changes := evs.record(cb, "change")
    evs.click(cb)
    assert_true(cb.checked())
    assert_eq(len(changes), 1)
    cb.add_event_listener("click", (e) => e.prevent_default())
    evs.click(cb)
    assert_true(cb.checked())
    radios := doc.query_selector_all("input[type=radio]")
    evs.click(radios[1])
    assert_false(radios[0].checked())
    assert_true(radios[1].checked())
    evs.select_option(doc.query_selector("select"), "b")
    assert_eq(doc.query_selector("select").value(), "b")
    assert_eq(doc.query_selector("textarea").value(), "défaut")
    evs.press_key(q, "Enter")
    assert_eq(submits, ["submit"])
    assert_eq(doc.submissions[0][1], [("q", "chat"), ("c", "oui"), ("r", "2"), ("s", "b"), ("t", "défaut")])
    evs.click(doc.query_selector("button[type=reset]"))
    assert_eq(q.value(), "")
    assert_true(radios[0].checked())
    evs.click(doc.query_selector("a"))
    assert_eq(doc.navigations, [("/x", null)])
    evs.click(doc.query_selector("summary"))
    assert_true(doc.query_selector("details").has_attribute("open"))
    q.focus()
    evs.press_key(q, "Tab")
    assert_true(doc.active_element() == cb)
    focus_log := []
    q.add_event_listener("focus", (e) => append(focus_log, "focus"))
    q.add_event_listener("blur", (e) => append(focus_log, "blur"))
    q.focus()
    q.blur()
    assert_eq(focus_log, ["focus", "blur"])
    assert_eq(win.confirm("Sûr ?"), true)
    win.confirm_answers = [false]
    assert_eq(win.confirm("Sûr ?"), false)
    assert_eq(len(win.alerts), 2)

testing.test("formulaires et interactions simulées", t_forms_interaction)

func t_observers():
    doc := page()
    log := []
    obs := mo.MutationObserver((recs, o) => append(log, recs))
    ul := doc.get_element_by_id("l")
    obs.observe(doc.body(), {"child_list": true, "subtree": true, "attributes": true, "attribute_old_value": true, "character_data": true})
    ul.append_child(doc.create_element("li"))
    ul.set_attribute("data-n", "3")
    ul.set_attribute("data-n", "4")
    ul.first_element_child().first_child().set_data("un")
    assert_eq(len(log), 0)
    mo.flush(doc)
    assert_eq(len(log), 1)
    recs := log[0]
    assert_eq(len(recs), 4)
    assert_eq(recs[0].type, "childList")
    assert_eq(len(recs[0].added_nodes), 1)
    assert_eq(recs[2].old_value, "3")
    assert_eq(recs[3].type, "characterData")
    obs2 := mo.MutationObserver((recs2, o) => append(log, recs2))
    obs2.observe(ul, {"attributes": true, "attribute_filter": ["class"]})
    ul.set_attribute("title", "x")
    ul.set_attribute("class", "y")
    assert_eq(len(obs2.take_records()), 1)
    obs.disconnect()
    assert_raises(() => obs2.observe(ul, {}), "TypeError")
    win := dom.window(doc)
    li := ul.first_element_child()
    li.set_layout(0, 2000, 300, 100)
    seen := []
    iobs := io.IntersectionObserver((es, o) => append(seen, (es[0].is_intersecting, es[0].intersection_ratio)), {"threshold": [0, 0.5, 1]})
    iobs.observe(li)
    iobs.flush()
    win.scroll_to(0, 1600)
    iobs.flush()
    win.scroll_to(0, 1330)
    iobs.flush()
    assert_eq(seen, [(false, 0.0), (true, 1.0), (true, 0.5)])
    m := io.IntersectionObserver((es, o) => null, {"root_margin": "0px 0px 2000px 0px"})
    m.observe(li)
    assert_true(m.take_records()[0].is_intersecting)
    sizes := []
    r := ro.ResizeObserver((es, o) => append(sizes, es[0].content_rect.width))
    r.observe(li)
    r.flush()
    li.set_layout(0, 2000, 420, 100)
    r.flush()
    li.set_layout(5, 2000, 420, 100)
    r.flush()
    assert_eq(sizes, [300, 420])

testing.test("observateurs", t_observers)

func t_window_tree():
    doc := dom.parse("<!DOCTYPE html><style>li { color: red } @media (max-width: 600px) { li { color: blue } }</style><style media=print>li { color: black }</style><ul><li style='font-weight: bold'>1</li></ul><p hidden>caché</p>")
    win := dom.window(doc, 390, 844, 3)
    li := doc.query_selector("li")
    st := win.get_computed_style(li)
    assert_eq(st.get("color"), "blue")
    assert_eq(st.get("display"), "list-item")
    assert_eq(st.get("font-weight"), "bold")
    assert_eq(win.get_computed_style(doc.query_selector("p")).get("display"), "none")
    mq := win.match_media("(max-width: 600px)")
    changes := []
    mq.add_event_listener("change", (e) => append(changes, e.matches))
    assert_true(mq.matches())
    resizes := evs.record(win, "resize")
    win.resize(1024, 768)
    assert_eq(changes, [false])
    assert_eq(len(resizes), 1)
    assert_eq(win.get_computed_style(li).get("color"), "red")
    dark := win.match_media("(prefers-color-scheme: dark)")
    win.set_color_scheme("dark")
    assert_true(dark.matches())
    assert_raises(() => win.set_timeout(() => null, 10), "NotSupportedError")
    w := tree.TreeWalker(doc.body(), tree.SHOW_ELEMENT)
    names := []
    n := w.next_node()
    while n != null:
        append(names, n.local_name)
        n = w.next_node()
    assert_eq(names, ["ul", "li", "p"])
    assert_eq(w.previous_node().local_name, "li")
    assert_eq(w.parent_node().local_name, "ul")
    skip_li := tree.TreeWalker(doc.body(), tree.SHOW_ELEMENT, (x) => tree.FILTER_SKIP if x.local_name == "li" else tree.FILTER_ACCEPT)
    assert_eq(len(skip_li.collect()), 2)
    it := tree.NodeIterator(doc.body(), tree.SHOW_TEXT)
    assert_eq(it.next_node().data, "1")
    assert_eq(it.next_node().data, "caché")
    assert_null(it.next_node())
    assert_eq(tree.path_to(li), "html > body:nth-child(2) > ul:nth-child(1) > li:nth-child(1)")
    div := doc.create_element("div")
    tree.wrap(doc.query_selector("ul"), div)
    assert_eq(div.first_element_child().local_name, "ul")
    tree.unwrap(div)
    assert_eq(doc.body().first_element_child().local_name, "ul")
    assert_eq(tree.common_ancestor(li, doc.query_selector("p")).local_name, "body")
    assert_eq(de.code_of("NotFoundError"), 8)

testing.test("fenêtre, styles et parcours", t_window_tree)

func t_entry():
    doc := dom.parse("<!DOCTYPE html><ul id=l><li>Un</li></ul><button>OK</button>")
    log := []
    stop := dom.on(doc.query_selector("button"), "click", (e) => append(log, "clic"))
    dom.click(doc.query_selector("button"))
    stop()
    dom.click(doc.query_selector("button"))
    assert_eq(log, ["clic"])
    assert_eq(dom.query_all(doc, "li").length(), 1)
    f := dom.fragment("<li>a</li><li>b</li>", doc)
    doc.get_element_by_id("l").append_child(f)
    assert_eq(dom.query_all(doc, "li").length(), 3)
    assert_eq(dom.serialize(doc.get_element_by_id("l")), "<ul id=\"l\"><li>Un</li><li>a</li><li>b</li></ul>")
    recs := []
    o := dom.observe_mutations(doc.body(), (r, ob) => append(recs, len(r)))
    doc.body().append_child(doc.create_element("p"))
    dom.flush(doc)
    assert_eq(recs, [1])
    d2 := dom.document("Vide", "fr")
    assert_eq(d2.to_html(), "<!DOCTYPE html><html lang=\"fr\"><head><title>Vide</title></head><body></body></html>")

testing.test("point d'entrée web.dom", t_entry)

