func t_timezone_lookup():
    assert_eq(datetime.get_timezone("Europe/Paris").std_offset, 3600)
    assert_eq(datetime.get_timezone("europe/paris").name, "Europe/Paris")
    assert_eq(datetime.get_timezone("Paris").name, "Europe/Paris")
    assert_eq(datetime.get_timezone("new york").name, "America/New_York")
    assert_eq(datetime.get_timezone("UTC").std_offset, 0)
    assert_eq(datetime.get_timezone("Z").name, "UTC")
    assert_eq(datetime.get_timezone("+02:00").std_offset, 7200)
    assert_eq(datetime.get_timezone("UTC-5").std_offset, -18000)
    assert_eq(datetime.get_timezone("GMT+05:30").std_offset, 19800)
    assert_eq(datetime.get_timezone("-0330").std_offset, -12600)
    assert_eq(datetime.get_timezone(3600).name, "UTC+01:00")
    assert_eq(datetime.fixed_offset(Duration(hours=2)).std_offset, 7200)
    assert_true(datetime.get_timezone("Europe/Paris").has_dst())
    assert_false(datetime.get_timezone("Asia/Tokyo").has_dst())
    assert_true(len(datetime.timezone_names()) > 50)
    assert_raises(() => datetime.get_timezone("Mars/Olympus"), "ValueError")
    assert_raises(() => datetime.get_timezone("+25:00"), "ValueError")
    assert_raises(() => datetime.get_timezone(1.5), "TypeError")
    z := datetime.TimeZone("Test/Zone", -12600, 3600, "us", "NST", "NDT")
    assert_eq(len(z.transitions(2026)), 2)
    assert_true(z.transitions(2026)[0]["to_dst"])
    assert_eq(len(datetime.UTC.transitions(2026)), 0)
    assert_raises(() => datetime.TimeZone("x", 0, 3600), "ValueError")
    assert_raises(() => datetime.TimeZone("x", 90000), "ValueError")
    custom := datetime.TimeZone("Custom", 0, 1800, {"start": [4, 1, 6, 0, "utc"], "end": [9, -1, 6, 0, "utc"]})
    assert_eq(datetime.DateTime(2026, 7, 1, 12, 0, 0, 0, custom).utc_offset(), 1800)
    assert_eq(datetime.DateTime(2026, 1, 1, 12, 0, 0, 0, custom).utc_offset(), 0)

testing.test("recherche de fuseaux, fuseaux personnalisés", t_timezone_lookup)

func t_datetime_basic():
    dt := DateTime(2026, 10, 7, 14, 30, 5, 250000)
    assert_true(dt.is_naive())
    assert_eq(dt.isoformat(), "2026-10-07T14:30:05.250000")
    assert_eq(dt.to_string(), "2026-10-07 14:30:05.250000")
    assert_eq(dt.to_date().isoformat(), "2026-10-07")
    assert_eq(dt.to_time().isoformat("seconds"), "14:30:05")
    assert_eq(dt.weekday(), 2)
    assert_eq(dt.quarter(), 4)
    assert_eq(dt.format("%d/%m/%Y %Hh%M", "fr"), "07/10/2026 14h30")
    assert_eq(dt.plus(Duration(hours=10)).isoformat("T", "seconds"), "2026-10-08T00:30:05")
    assert_eq(dt.minus(Duration(days=1, microseconds=250001)).isoformat("T", "microseconds"), "2026-10-06T14:30:04.999999")
    assert_eq(dt.plus_months(4).isoformat("T", "minutes"), "2027-02-07T14:30")
    assert_eq(DateTime(2026, 1, 31, 8).plus_months(1).day, 28)
    assert_eq(dt.plus_years(-3).year, 2023)
    assert_eq(dt.plus_millis(750).microsecond, 0)
    assert_eq(dt.plus_micros(-250001).second, 4)
    assert_eq(dt.diff(DateTime(2026, 10, 6)).total_seconds(), 138605.25)
    assert_eq(dt.until(DateTime(2026, 10, 8)).total_seconds(), 34194.75)
    assert_true(dt.gt(DateTime(2026, 10, 7)))
    assert_true(dt.is_before(DateTime(2027, 1, 1)))
    assert_true(dt.equals(DateTime(2026, 10, 7, 14, 30, 5, 250000)))
    assert_false(dt.equals(Date(2026, 10, 7)))
    assert_eq(dt.months_between(DateTime(2026, 7, 7, 14, 30, 6)), 2)
    assert_eq(dt.days_between(DateTime(2026, 10, 1, 14, 30, 6)), 5)
    assert_eq(dt.replace(null, null, null, 0, 0).isoformat(), "2026-10-07T00:00:05.250000")
    assert_eq(dt.truncate("hour").isoformat(), "2026-10-07T14:00:00")
    assert_eq(dt.truncate("week").isoformat(), "2026-10-05T00:00:00")
    assert_eq(dt.truncate("quarter").isoformat(), "2026-10-01T00:00:00")
    assert_eq(DateTime(2026, 10, 7, 14, 30, 5, 250999).truncate("millisecond").microsecond, 250000)
    assert_eq(dt.ceil("hour").isoformat(), "2026-10-07T15:00:00")
    assert_eq(dt.ceil("day").isoformat(), "2026-10-08T00:00:00")
    assert_eq(DateTime(2026, 10, 7, 15).ceil("hour").hour, 15)
    assert_eq(dt.ceil("month").isoformat(), "2026-11-01T00:00:00")
    assert_eq(dt.end_of_day().isoformat(), "2026-10-07T23:59:59.999999")
    assert_eq(dt.start_of_day().hour, 0)
    assert_raises(() => dt.truncate("decade"), "ValueError")
    assert_raises(() => DateTime(2026, 10, 7, 24), "ValueError")
    assert_raises(() => DateTime(2026, 10, 7, 0, 0, 0, 0, null, 2), "ValueError")
    assert_raises(() => dt.astimezone("UTC"), "ValueError")
    assert_eq(datetime.combine(Date(2026, 10, 7), Time(8, 15)).isoformat("T", "minutes"), "2026-10-07T08:15")
    assert_eq(datetime.earliest([dt, DateTime(2020, 1, 1), DateTime(2030, 1, 1)]).year, 2020)
    assert_eq(datetime.latest([dt, DateTime(2020, 1, 1), DateTime(2030, 1, 1)]).year, 2030)
    rg := datetime.datetime_range(DateTime(2026, 1, 1), DateTime(2026, 1, 2), Duration(hours=6), true)
    assert_eq(len(rg), 5)
    assert_eq(len(datetime.datetime_range(DateTime(2026, 1, 1), DateTime(2026, 1, 2), Duration(hours=6))), 4)
    assert_eq(len(datetime.datetime_range(DateTime(2026, 1, 2), DateTime(2026, 1, 1), Duration(hours=-12), true)), 3)
    assert_raises(() => datetime.datetime_range(dt, dt, Duration(0)), "ValueError")

testing.test("DateTime naïf", t_datetime_basic)

func t_datetime_aware():
    paris := datetime.get_timezone("Europe/Paris")
    dt := DateTime(2026, 10, 7, 14, 30, 5, 0, paris)
    assert_true(dt.is_aware())
    assert_eq(dt.utc_offset(), 7200)
    assert_eq(dt.tzname(), "CEST")
    assert_true(dt.is_dst())
    assert_eq(dt.isoformat(), "2026-10-07T14:30:05+02:00")
    assert_eq(dt.to_utc().isoformat("T", "auto", true), "2026-10-07T12:30:05Z")
    assert_eq(dt.astimezone("Asia/Tokyo").isoformat(), "2026-10-07T21:30:05+09:00")
    assert_eq(dt.astimezone("America/New_York").isoformat(), "2026-10-07T08:30:05-04:00")
    assert_eq(dt.format("%Z %z %:z"), "CEST +0200 +02:00")
    assert_eq(dt.timestamp(), 1791376205.0)
    assert_eq(dt.timestamp_ms(), 1791376205000)
    assert_eq(dt.with_tz("UTC").isoformat(), "2026-10-07T14:30:05+00:00")
    assert_eq(dt.to_naive().isoformat(), "2026-10-07T14:30:05")
    assert_eq(dt.rfc2822(), "Wed, 07 Oct 2026 14:30:05 +0200")
    assert_eq(dt.http_date(), "Wed, 07 Oct 2026 12:30:05 GMT")
    # comparaison par instant, quel que soit le fuseau
    tokyo := dt.astimezone("Asia/Tokyo")
    assert_eq(dt.compare(tokyo), 0)
    assert_true(dt.equals(tokyo))
    assert_eq(dt.diff(tokyo).total_seconds(), 0.0)
    assert_true(dt.lt(DateTime(2026, 10, 7, 14, 0, 0, 0, "UTC")))
    assert_raises(() => dt.compare(DateTime(2026, 10, 7)), "TypeError")
    assert_raises(() => dt.diff(DateTime(2026, 10, 7)), "TypeError")
    # arithmétique murale vs temps écoulé autour du saut de printemps (29 mars 2026, Paris)
    before := DateTime(2026, 3, 29, 1, 30, 0, 0, paris)
    assert_eq(before.plus(Duration(hours=1)).isoformat(), "2026-03-29T02:30:00+01:00")
    assert_eq(before.plus_exact(Duration(hours=1)).isoformat(), "2026-03-29T03:30:00+02:00")
    assert_eq(before.plus(Duration(hours=1)).normalize().isoformat(), "2026-03-29T03:30:00+02:00")
    assert_eq(DateTime(2026, 3, 28, 12, 0, 0, 0, paris).plus_days(1).utc_offset(), 7200)
    assert_eq(DateTime(2026, 3, 28, 12, 0, 0, 0, paris).plus_days(1).diff(DateTime(2026, 3, 28, 12, 0, 0, 0, paris)).total_hours(), 23.0)
    # retour à l'heure d'hiver (25 octobre 2026) : heure répétée et fold
    first := DateTime(2026, 10, 25, 2, 30, 0, 0, paris, 0)
    second := DateTime(2026, 10, 25, 2, 30, 0, 0, paris, 1)
    assert_eq(first.utc_offset(), 7200)
    assert_eq(second.utc_offset(), 3600)
    assert_eq(second.diff(first).total_seconds(), 3600.0)
    u := DateTime(2026, 10, 25, 0, 30, 0, 0, "UTC")
    assert_eq(u.astimezone(paris).fold, 0)
    assert_eq(u.plus_exact(Duration(hours=1)).astimezone(paris).fold, 1)
    assert_eq(u.plus_exact(Duration(hours=1)).astimezone(paris).isoformat(), "2026-10-25T02:30:00+01:00")
    # sans limite : année 100000 en UTC et dans un fuseau fixe
    far := DateTime(100000, 6, 15, 12, 0, 0, 0, "+05:30")
    assert_eq(far.to_utc().isoformat("T", "minutes"), "+100000-06-15T06:30+00:00")
    assert_eq(far.plus_exact(Duration(days=365243000000)).year, 100000 + 1000001369)
    assert_eq(DateTime(-500, 1, 1, 0, 0, 0, 0, "UTC").timestamp_parts()[0], -77945673600)

testing.test("DateTime avec fuseau : conversions, saut d'heure, fold", t_datetime_aware)

func t_datetime_parse():
    a := datetime.from_iso("2026-10-07T14:30:05+02:00")
    assert_eq(a.utc_offset(), 7200)
    assert_eq(a.to_utc().hour, 12)
    assert_eq(datetime.from_iso("2026-10-07T14:30:05Z").tz.name, "UTC")
    assert_true(datetime.from_iso("2026-10-07T14:30:05").is_naive())
    assert_true(datetime.from_iso("2026-10-07").is_naive())
    b := datetime.from_iso("2026-10-07T14:30:05", "Europe/Paris")
    assert_eq(b.utc_offset(), 7200)
    c := datetime.from_iso("2026-10-07T12:30:05Z", "Europe/Paris")
    assert_eq(c.hour, 14)
    assert_eq(datetime.from_iso(a.isoformat()).timestamp(), a.timestamp())
    p := datetime.parse("07/10/2026 14h30", "%d/%m/%Y %Hh%M", "fr", "Europe/Paris")
    assert_eq(p.isoformat("T", "minutes"), "2026-10-07T14:30+02:00")
    q := datetime.parse("Wed, 07 Oct 2026 14:30:05 +0200", "%a, %d %b %Y %H:%M:%S %z")
    assert_eq(q.to_utc().hour, 12)
    s := datetime.from_timestamp(1791360000, "Europe/Paris")
    assert_eq(s.isoformat(), "2026-10-07T10:00:00+02:00")
    assert_eq(datetime.from_timestamp(1791360000.5).microsecond, 500000)
    assert_eq(datetime.from_timestamp_parts(-1, 999999).isoformat("T", "microseconds"), "1969-12-31T23:59:59.999999+00:00")
    assert_eq(datetime.date_from_timestamp(1791360000, "Asia/Tokyo").isoformat(), "2026-10-07")
    assert_raises(() => datetime.from_iso("pas une date"), "ValueError")

testing.test("DateTime : from_iso, parse, timestamps", t_datetime_parse)

func t_now():
    fc := time.install_fake_clock(1791360000.0)
    time.set_local_zone(3600, "CET", false)
    n := datetime.now()
    assert_eq(n.isoformat(), "2026-10-07T09:00:00+01:00")
    assert_eq(datetime.now("Asia/Tokyo").hour, 17)
    assert_eq(datetime.now_utc().hour, 8)
    assert_eq(datetime.today().isoformat(), "2026-10-07")
    assert_eq(datetime.local_timezone().std_offset, 3600)
    assert_eq(DateTime(2026, 10, 7, 5, 0, 0, 0, "UTC").humanize(), "3 hours ago")
    assert_eq(DateTime(2026, 10, 8, 8, 0, 0, 0, "UTC").humanize(null, "fr"), "dans un jour")
    assert_eq(DateTime(2026, 10, 7, 10, 0, 0, 0, "UTC").humanize(DateTime(2026, 10, 7, 9, 0, 0, 0, "UTC")), "in an hour")
    time.set_local_zone(null)
    time.reset_clock()

testing.test("now / today avec horloge simulée", t_now)

