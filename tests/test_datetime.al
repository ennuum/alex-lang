# ALEX - tests du module datetime (ALEX pur). Lancer depuis la racine : ./alex run tests/test_datetime.al
# Références indépendantes : Python (datetime, zoneinfo) via tests/time_vectors.al (voir tools/time/).
use datetime
use time
use testing
from core use len
use tests.time_vectors as tv
from testing use assert_eq, assert_true, assert_false, assert_raises, assert_near
from datetime use Date, Time, DateTime, Duration, Period

func t_duration():
    d := Duration(days=1, hours=2, minutes=3, seconds=4, milliseconds=500)
    assert_eq(d.days, 1)
    assert_eq(d.seconds, 7384)
    assert_eq(d.microseconds, 500000)
    assert_near(d.total_seconds(), 93784.5)
    n := Duration(seconds=-1)
    assert_eq(n.days, -1)
    assert_eq(n.seconds, 86399)
    assert_true(n.is_negative())
    assert_eq(n.negate().seconds, 1)
    assert_eq(Duration(hours=1.5).total_seconds(), 5400.0)
    assert_eq(Duration(weeks=1, days=1).days, 8)
    assert_eq(Duration(microseconds=1500000).seconds, 1)
    assert_eq(Duration(days=1).plus(Duration(hours=36)).days, 2)
    assert_eq(Duration(days=1).minus(Duration(hours=36)).total_seconds(), -43200.0)
    assert_eq(Duration(hours=1).times(3).total_seconds(), 10800.0)
    assert_eq(Duration(hours=1).times(0.5).total_seconds(), 1800.0)
    assert_eq(Duration(hours=1).divided(4).total_seconds(), 900.0)
    assert_eq(Duration(hours=3).ratio(Duration(hours=2)), 1.5)
    assert_eq(Duration(hours=7).floordiv(Duration(hours=2)), 3)
    assert_eq(Duration(hours=7).modulo(Duration(hours=2)).total_seconds(), 3600.0)
    assert_eq(Duration(days=1).compare(Duration(hours=24)), 0)
    assert_true(Duration(hours=1).lt(Duration(hours=2)))
    assert_true(Duration(days=-1, hours=5).lt(Duration(0)))
    assert_true(Duration(hours=2).equals(Duration(minutes=120)))
    assert_eq(Duration(days=1, hours=2).format("long", "fr"), "1 jour et 2 heures")
    assert_eq(Duration(days=1, hours=2).iso(), "P1DT2H")
    assert_eq(Duration(hours=26, minutes=3).format("clock"), "26:03:00")
    assert_eq(Duration(hours=-2).to_string(), "-2h")
    c := Duration(hours=-26, minutes=-3).components()
    assert_eq(c["sign"], -1)
    assert_eq(c["days"], 1)
    assert_eq(c["hours"], 2)
    assert_eq(c["minutes"], 3)
    # sans limite : un milliard d'années
    big := Duration(days=365243000000)
    assert_eq(big.plus(Duration(days=1)).days, 365243000001)
    assert_raises(() => big.times(1000).total_microseconds(), "ValueError")
    assert_raises(() => Duration(days="1"), "TypeError")
    assert_raises(() => Duration(hours=1).divided(0), "ZeroDivisionError")
    assert_raises(() => Duration(hours=1).plus(5), "TypeError")
    assert_eq(datetime.parse_duration("1h30m").total_seconds(), 5400.0)
    assert_eq(datetime.parse_duration("-PT1S").seconds, 86399)
    assert_eq(datetime.duration_from_seconds(90.5).microseconds, 500000)

testing.test("Duration", t_duration)

func t_period():
    p := Period(years=1, months=2, days=3)
    assert_eq(p.iso(), "P1Y2M3D")
    assert_eq(Period().iso(), "P0D")
    assert_eq(p.total_months(), 14)
    assert_eq(p.apply_to(Date(2026, 1, 31)).isoformat(), "2027-04-03")
    assert_eq(Period(months=1).apply_to(Date(2026, 1, 31)).isoformat(), "2026-02-28")
    assert_eq(p.negate().apply_to(Date(2026, 10, 7)).isoformat(), "2025-08-04")
    assert_eq(datetime.period_between(Date(1990, 5, 17), Date(2026, 10, 7)).iso(), "P36Y4M20D")
    assert_eq(datetime.period_between(Date(2026, 10, 7), Date(1990, 5, 17)).iso(), "P-36Y-4M-21D")
    assert_eq(datetime.period_between(Date(2026, 1, 31), Date(2026, 3, 1)).iso(), "P1M1D")
    assert_eq(datetime.period_between(Date(2026, 5, 5), Date(2026, 5, 5)).iso(), "P0D")
    assert_raises(() => Period(years=1.5), "TypeError")

testing.test("Period", t_period)

func t_date_vs_python():
    for r in tv.CIVIL:
        d := Date(r[1], r[2], r[3])
        assert_eq(d.to_days(), r[0])
        assert_eq(d.weekday(), r[4])
        assert_eq(d.yearday(), r[5])
        assert_eq(d.iso_calendar(), (r[6], r[7], r[8]))
        assert_eq(d.to_ordinal(), r[9])
        assert_true(datetime.date_from_days(r[0]).equals(d))
        assert_true(datetime.date_from_ordinal(r[9]).equals(d))
        assert_true(datetime.date_from_iso_week(r[6], r[7], r[8]).equals(d))
        assert_true(datetime.date_from_iso(d.isoformat()).equals(d))

testing.test("Date vs Python (414 dates)", t_date_vs_python)

func t_date():
    d := Date(2026, 10, 7)
    assert_eq(d.isoformat(), "2026-10-07")
    assert_eq(d.quarter(), 4)
    assert_eq(d.week(), 41)
    assert_false(d.is_leap_year())
    assert_eq(d.plus_days(25).isoformat(), "2026-11-01")
    assert_eq(d.minus_days(7).isoformat(), "2026-09-30")
    assert_eq(d.plus_weeks(-2).isoformat(), "2026-09-23")
    assert_eq(Date(2026, 1, 31).plus_months(1).isoformat(), "2026-02-28")
    assert_eq(Date(2024, 1, 31).plus_months(1).isoformat(), "2024-02-29")
    assert_eq(Date(2024, 2, 29).plus_years(1).isoformat(), "2025-02-28")
    assert_eq(Date(2026, 1, 15).plus_months(-14).isoformat(), "2024-11-15")
    assert_eq(d.plus(Duration(days=3)).isoformat(), "2026-10-10")
    assert_raises(() => d.plus(Duration(hours=3)), "ValueError")
    assert_eq(d.diff(Date(2026, 1, 1)).days, 279)
    assert_eq(d.days_until(Date(2026, 12, 25)), 79)
    assert_eq(Date(2026, 10, 7).months_between(Date(2025, 10, 8)), 11)
    assert_eq(Date(2026, 10, 8).years_between(Date(2025, 10, 8)), 1)
    assert_eq(Date(2025, 10, 8).years_between(Date(2026, 10, 7)), 0)
    assert_eq(d.start_of_week().isoformat(), "2026-10-05")
    assert_eq(d.end_of_week().isoformat(), "2026-10-11")
    assert_eq(d.start_of_week(6).isoformat(), "2026-10-04")
    assert_eq(d.end_of_month().isoformat(), "2026-10-31")
    assert_eq(d.start_of_quarter().isoformat(), "2026-10-01")
    assert_eq(d.end_of_quarter().isoformat(), "2026-12-31")
    assert_eq(d.end_of_year().isoformat(), "2026-12-31")
    assert_eq(d.next_weekday(2).isoformat(), "2026-10-14")
    assert_eq(d.next_weekday(3).isoformat(), "2026-10-08")
    assert_eq(d.prev_weekday(2).isoformat(), "2026-09-30")
    assert_eq(d.nth_weekday(0, 1).isoformat(), "2026-10-05")
    assert_eq(d.nth_weekday(6, -1).isoformat(), "2026-10-25")
    assert_eq(d.replace(null, 2, 28).isoformat(), "2026-02-28")
    assert_true(d.lt(Date(2026, 10, 8)))
    assert_true(d.is_between(Date(2026, 1, 1), Date(2026, 12, 31)))
    assert_eq(d.format("%A %-d %B %Y", "fr"), "mercredi 7 octobre 2026")
    assert_eq(d.at(14, 30).isoformat(), "2026-10-07T14:30:00")
    assert_true(Date(2026, 10, 10).is_weekend())
    assert_eq(Date(-44, 3, 15).isoformat(), "-0044-03-15")
    assert_eq(Date(12345, 1, 1).isoformat(), "+12345-01-01")
    assert_eq(datetime.date_from_iso("+12345-01-01").year, 12345)
    assert_eq(Date(0, 2, 29).isoformat(), "0000-02-29")
    assert_eq(Date(1000000000, 6, 15).plus_days(366).isoformat(), "+1000000001-06-16")
    assert_raises(() => Date(2026, 2, 29), "ValueError")
    assert_raises(() => Date(2026, 0, 1), "ValueError")
    assert_raises(() => Date(2026.0, 1, 1), "TypeError")
    assert_raises(() => datetime.date_from_iso("2026-10-07T10:00"), "ValueError")
    assert_raises(() => d.diff("x"), "TypeError")
    assert_eq(datetime.parse_date("7 octobre 2026", "%d %B %Y", "fr").isoformat(), "2026-10-07")

testing.test("Date : arithmétique, bornes, années illimitées", t_date)

func t_date_range_business():
    r := datetime.date_range(Date(2026, 10, 1), Date(2026, 10, 5))
    assert_eq(len(r), 5)
    assert_eq(len(datetime.date_range(Date(2026, 10, 1), Date(2026, 10, 5), 2)), 3)
    assert_eq(len(datetime.date_range(Date(2026, 10, 5), Date(2026, 10, 1), -1, false)), 4)
    assert_eq(len(datetime.date_range(Date(2026, 10, 1), Date(2026, 10, 1), 1, false)), 0)
    assert_raises(() => datetime.date_range(Date(2026, 1, 1), Date(2026, 1, 2), 0), "ValueError")
    fri := Date(2026, 10, 9)
    assert_eq(fri.plus_business_days(1).isoformat(), "2026-10-12")
    assert_eq(fri.plus_business_days(5).isoformat(), "2026-10-16")
    assert_eq(Date(2026, 10, 12).plus_business_days(-1).isoformat(), "2026-10-09")
    hol := [Date(2026, 10, 12)]
    assert_eq(fri.plus_business_days(1, hol).isoformat(), "2026-10-13")
    assert_false(Date(2026, 10, 12).is_business_day(hol))
    assert_true(Date(2026, 10, 13).is_business_day(hol))
    assert_eq(Date(2026, 10, 5).business_days_until(Date(2026, 10, 12)), 5)
    assert_eq(Date(2026, 10, 12).business_days_until(Date(2026, 10, 5)), -5)
    assert_eq(Date(2026, 10, 5).business_days_until(Date(2026, 10, 12), hol), 5)
    assert_eq(Date(2026, 10, 9).business_days_until(Date(2026, 10, 14), hol), 2)
    e := datetime.easter_date(2026)
    assert_eq(e.isoformat(), "2026-04-05")
    fr := datetime.holidays_fr(2026)
    assert_eq(len(fr), 11)
    assert_eq(fr[1][0].isoformat(), "2026-04-06")
    assert_eq(fr[4][0].isoformat(), "2026-05-14")
    assert_eq(fr[5][0].isoformat(), "2026-05-25")
    assert_eq(len(datetime.holiday_dates_fr(2026)), 11)
    assert_eq(datetime.age(Date(1990, 5, 17), Date(2026, 5, 16)), 35)
    assert_eq(datetime.age(Date(1990, 5, 17), Date(2026, 5, 17)), 36)

testing.test("plages de dates, jours ouvrés, fériés", t_date_range_business)

func t_time():
    t := Time(14, 30, 5, 250000)
    assert_eq(t.isoformat(), "14:30:05.250000")
    assert_eq(t.isoformat("minutes"), "14:30")
    assert_eq(t.isoformat("milliseconds"), "14:30:05.250")
    assert_eq(Time(9).to_string(), "09:00:00")
    assert_eq(t.to_micros(), 52205250000)
    assert_near(t.to_seconds(), 52205.25)
    assert_eq(Time(23, 30).plus(Duration(hours=2)).isoformat(), "01:30:00")
    assert_eq(Time(0, 30).minus(Duration(hours=1)).isoformat(), "23:30:00")
    c := Time(23, 30).plus_with_carry(Duration(hours=26))
    assert_eq(c[0].isoformat(), "01:30:00")
    assert_eq(c[1], 2)
    assert_eq(Time(12).diff(Time(10, 30)).total_seconds(), 5400.0)
    assert_true(Time(1).lt(Time(2)))
    assert_true(Time(1, 2, 3).equals(Time(1, 2, 3)))
    assert_eq(t.replace(null, 0).isoformat("auto"), "14:00:05.250000")
    assert_eq(t.truncate("minute").isoformat(), "14:30:00")
    assert_eq(t.format("%I:%M %p"), "02:30 PM")
    assert_eq(t.at(Date(2026, 10, 7)).isoformat(), "2026-10-07T14:30:05.250000")
    assert_eq(datetime.time_from_iso("14:30:05.25").microsecond, 250000)
    assert_eq(datetime.time_from_micros(52205250000).hour, 14)
    assert_eq(datetime.time_from_seconds(3661.5).isoformat(), "01:01:01.500000")
    assert_eq(datetime.parse_time("2h05 PM", "%Ih%M %p").hour, 14)
    assert_true(datetime.midnight().is_midnight())
    assert_eq(datetime.noon().hour, 12)
    assert_raises(() => Time(24), "ValueError")
    assert_raises(() => Time(1, 60), "ValueError")
    assert_raises(() => datetime.time_from_iso("10:00+02:00"), "ValueError")
    assert_raises(() => datetime.time_from_seconds(86400), "ValueError")

testing.test("Time", t_time)

func t_tz_vs_zoneinfo():
    for r in tv.TZ:
        dt := datetime.from_timestamp(r[1], r[0])
        assert_eq(dt.utc_offset(), r[2])
        assert_eq(dt.tzname(), r[3])
