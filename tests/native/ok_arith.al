# Arithmétique entière : mêmes résultats que la VM (division arrondie vers -inf, enroulement 64 bits).
func show(label: str, v: int):
    print(label)
    print(v)

show("7 // 2", 7 // 2)
show("-7 // 2", -7 // 2)
show("7 // -2", 7 // -2)
show("-7 // -2", -7 // -2)
show("7 % 3", 7 % 3)
show("-7 % 3", -7 % 3)
show("7 % -3", 7 % -3)
show("-7 % -3", -7 % -3)
min_int := -9223372036854775807 - 1
show("min", min_int)
show("min // -1", min_int // -1)
show("min % -1", min_int % -1)
show("max + 1", 9223372036854775807 + 1)
show("max * 2", 9223372036854775807 * 2)
show("-min", -min_int)
show("2 ** 10", 2 ** 10)
show("3 ** 0", 3 ** 0)
show("2 ** 63", 2 ** 63)
show("(-3) ** 3", (-3) ** 3)
show("1 << 62", 1 << 62)
show("1 << 63", 1 << 63)
show("-16 >> 2", -16 >> 2)
show("12 & 10", 12 & 10)
show("12 | 10", 12 | 10)
show("12 ^ 10", 12 ^ 10)
show("~5", ~5)
show("+5", +5)
show("big literal", 1234567890123)
show("mix", (3 + 4) * 5 - 6 // 4 % 3)
print(3 < 4, 4 < 3, 3 <= 3, 3 > 2, 2 >= 3, 5 == 5, 5 != 5)
print(true == false, true != false, not true, not 0, not 7)
