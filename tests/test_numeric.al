# =============================================================================
# ALEX - tests du module stdlib/numeric/numeric.al
# Polynômes, interpolation, racines, intégration.
# Les valeurs attendues proviennent de NumPy 2.4 / SciPy 1.17 (référence indépendante),
# jamais d'un calcul avec le module testé.
#
# Lancer DEPUIS LA RACINE DU PROJET :  ./alex run tests/test_numeric.al
# Code de sortie 0 si tout passe, 1 sinon.
# =============================================================================
use array
use numeric
use math
from core use len, is_bool
from collections use append, clear

tally := [0, 0]
notes := []
failed_groups := []

func ok():
    tally[0] = tally[0] + 1

func fail(label, detail):
    tally[1] = tally[1] + 1
    append(notes, f"{label} : {detail}")

func abs_val(v):
    if v < 0:
        return 0 - v
    return v

func check(cond, label):
    if cond:
        ok()
    else:
        fail(label, "condition fausse")

func check_eq(actual, expected, label):
    if actual == expected:
        ok()
    else:
        fail(label, f"obtenu {actual}, attendu {expected}")

# Erreur relative (absolue si |attendu| < 1).
func check_close(actual, expected, tol, label):
    if actual == null:
        fail(label, f"obtenu null, attendu {expected}")
    else:
        scale := abs_val(expected)
        if scale < 1:
            scale = 1
        if abs_val(actual - expected) <= tol * scale:
            ok()
        else:
            fail(label, f"obtenu {actual}, attendu {expected}")

# Compare deux listes de nombres (même longueur, tolérance relative tol).
func check_list_close(actual, expected, tol, label):
    if len(actual) != len(expected):
        fail(label, f"longueurs {len(actual)} et {len(expected)}")
    else:
        i := 0
        bad := 0
        while i < len(actual):
            if is_bool(expected[i]) or is_bool(actual[i]):
                if actual[i] != expected[i]:
                    bad = bad + 1
                    if bad == 1:
                        fail(label, f"élément {i} : obtenu {actual[i]}, attendu {expected[i]}")
            else:
                sc := abs_val(expected[i])
                if sc < 1:
                    sc = 1
                if abs_val(actual[i] - expected[i]) > tol * sc:
                    bad = bad + 1
                    if bad == 1:
                        fail(label, f"élément {i} : obtenu {actual[i]}, attendu {expected[i]}")
            i += 1
        if bad == 0:
            ok()

func run(name, fn):
    clear(notes)
    before := tally[1]
    fn()
    if tally[1] > before:
        append(failed_groups, name)
        print(f"  [ÉCHEC]  {name}")
        for n in notes:
            print(f"      {n}")
    else:
        print(f"  [OK]     {name}")

# Vrai si fn() (sans argument) lève une erreur.
func raises(fn):
    threw := false
    try:
        fn()
    catch e:
        threw = true
    return threw

func finish(title, groups):
    total := tally[0] + tally[1]
    print("")
    print(f"=== {title} ===")
    print(f"Groupes : {groups}, vérifications : {tally[0]} réussies, {tally[1]} en échec (sur {total})")
    if tally[1] > 0:
        print(f"Groupes en échec : {failed_groups}")
        raise("AssertionError", f"{tally[1]} vérification(s) en échec")
    print(f"TOUS LES TESTS {title} PASSENT")

# Compare un Array à une forme et une liste plate attendues.
func check_arr(a, shape, flat, tol, label):
    if not array.is_array(a):
        fail(label, "un Array était attendu")
    elif not array.array_equal(array.from_list(a.shape), array.from_list(shape)):
        fail(label, f"forme obtenue {a.shape}, attendue {shape}")
    else:
        check_list_close(a.data, flat, tol, label)

func f_cosx(x):
    return math.cos(x) - x

func f_cubic(x):
    return x * x * x - 2.0 * x - 5.0

func df_cubic(x):
    return 3.0 * x * x - 2.0

func f_exp3(x):
    return math.exp(x) - 3.0

func f_param(x, p):
    return x * x - p

func df_param(x, p):
    return 2.0 * x

func f_flat(x):
    return (x - 1.0) * (x - 1.0) * (x - 1.0)

func g_cos(x):
    return math.cos(x)

func g_sqrt2(x):
    return 0.5 * (x + 2.0 / x)

func h_gauss(x):
    return math.exp(0.0 - x * x)

func h_invsqrt(x):
    return 1.0 / math.sqrt(x)

func h_log(x):
    return math.ln(x)

func h_quad(x, p):
    return p[0] * x * x + p[1] * x + p[2]

func h_osc(x):
    return math.sin(50.0 * x)

func h_peak(x):
    return 1.0 / (1.0 + 25.0 * x * x)

func h_xexp(x):
    return x * math.exp(0.0 - x)

func h_lorentz(x):
    return 1.0 / (1.0 + x * x)

func h_poly9(x):
    return 5.0 * x ** 9 - 3.0 * x ** 4 + x - 7.0

func h_abs(x):
    return math.abs(x - 0.3)

func h_exp(x):
    return math.exp(x)

func h_cos2(x):
    return math.cos(x) * math.cos(x)

func h_sin_over_x(x):
    return math.sin(x) / x

func h_nan(x):
    return 1.0 / (x - 0.5)

func flat_pairs(l):
    out := []
    for p in l:
        append(out, p[0])
        append(out, p[1])
    return out

func sorted_roots(l):
    n := len(l)
    out := []
    for p in l:
        append(out, [p[0], p[1]])
    i := 0
    while i < n:
        j := 0
        while j < n - 1 - i:
            a := out[j]
            b := out[j + 1]
            swap := false
            if abs_val(a[0] - b[0]) <= 0.000001:
                if a[1] > b[1] + 0.000001:
                    swap = true
            elif a[0] > b[0]:
                swap = true
            if swap:
                out[j] = b
                out[j + 1] = a
            j = j + 1
        i = i + 1
    return out

