func t_sin():
    check_eq(math.sin(0), 0, "sin(0)")
    check_close(math.sin(0.5235987755982988), 0.5, TOL, "sin(0.5235987755982988)")
    check_close(math.sin(1.5707963267948966), 1, TOL, "sin(1.5707963267948966)")
    check_close(math.sin(-1.5707963267948966), -1, TOL, "sin(-1.5707963267948966)")
    check_close(math.sin(1), 0.8414709848078965, TOL, "sin(1)")
    check_close(math.sin(-1), -0.8414709848078965, TOL, "sin(-1)")
    check_close(math.sin(10), -0.5440211108893698, TOL, "sin(10)")
    check_close(math.sin(-10), 0.5440211108893698, TOL, "sin(-10)")
    check_close(math.sin(100), -0.5063656411097588, TOL, "sin(100)")
    check_close(math.sin(-100), 0.5063656411097588, TOL, "sin(-100)")
    check_close(math.sin(0.000001), 0.0000009999999999998333, TOL, "sin(1e-06)")
    check_close(math.sin(6.283185307179586), -0.00000000000000024492935982947064, TOL, "sin(6.283185307179586)")
    check_close(math.sin(3.141592653589793), 0, TOL, "sin(3.141592653589793)")
    # Grands arguments (réduction de Cody-Waite à 3 niveaux : précision pleine jusqu'à |x| ~ 1e6).
    check_close(math.sin(1000), 0.8268795405320025, TOL, "sin(1000) [grand argument]")
    check_close(math.sin(3000), 0.21918997428281808, TOL, "sin(3000) [grand argument]")
    check_close(math.sin(100000), 0.03574879797201651, 0.000000001, "sin(100000) [très grand argument, tol 1e-9]")

func t_precision_exp_trig():
    # Non-régression : exp/sin/cos/tan à ~1 ulp (tolérance relative 1e-15), y compris grands arguments,
    # voisinage des zéros et valeurs extrêmes. Références : module math de Python.
    check_rel(math.exp(0.5), 1.6487212707001282, 0.000000000000001, "exp(0.5) [1 ulp]")
    check_rel(math.exp(1.0), 2.718281828459045, 0.000000000000001, "exp(1.0) [1 ulp]")
    check_rel(math.exp(10.0), 22026.465794806718, 0.000000000000001, "exp(10.0) [1 ulp]")
    check_rel(math.exp(-19.9906687239457), 0.0000000020804768307652856, 0.000000000000001, "exp(-19.9906687239457) [1 ulp]")
    check_rel(math.exp(-15.8045797050964), 0.000000136822728015114, 0.000000000000001, "exp(-15.8045797050964) [1 ulp]")
    check_rel(math.exp(18.7376146151757), 137291177.9947035, 0.000000000000001, "exp(18.7376146151757) [1 ulp]")
