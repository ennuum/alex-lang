    check_rel(math.sqrt(1000000), 1000.0, TOL, "sqrt(1000000)")
    check_rel(math.sqrt(999999999999), 999999.9999995, TOL, "sqrt(999999999999)")
    check_rel(math.sqrt(2), 1.4142135623730951, TOL, "sqrt(2)")
