    check_eq(math.lcm(1000, 1500), 3000, "lcm(1000, 1500)")
    check_type(math.lcm(1000, 1500), "int", "lcm(1000, 1500) est un int")
    # BUG connu : lcm passe par une division flottante (a*b)/gcd -> perte de précision au-delà de 2^53.
    check_eq(math.lcm(1000000007, 998244353), 998244359987710471, "lcm(1000000007, 998244353) [grands entiers, division flottante]")
    check_eq(math.lcm(2147483647, 2147483629), 4611685975477714963, "lcm(2147483647, 2147483629) [grands entiers]")

func t_factorial():
    check_eq(math.factorial(0), 1, "factorial(0)")
    check_type(math.factorial(0), "int", "factorial(0) est un int")
    check_eq(math.factorial(1), 1, "factorial(1)")
    check_type(math.factorial(1), "int", "factorial(1) est un int")
    check_eq(math.factorial(2), 2, "factorial(2)")
    check_type(math.factorial(2), "int", "factorial(2) est un int")
    check_eq(math.factorial(5), 120, "factorial(5)")
    check_type(math.factorial(5), "int", "factorial(5) est un int")
    check_eq(math.factorial(10), 3628800, "factorial(10)")
    check_type(math.factorial(10), "int", "factorial(10) est un int")
    check_eq(math.factorial(15), 1307674368000, "factorial(15)")
    check_type(math.factorial(15), "int", "factorial(15) est un int")
    check_eq(math.factorial(20), 2432902008176640000, "factorial(20)")
    check_type(math.factorial(20), "int", "factorial(20) est un int")
    check_eq(math.factorial(5.0), 120, "factorial(5)")
    check_null(math.factorial(-1), "factorial(-1) -> null")
    check_null(math.factorial(-10), "factorial(-10) -> null")
    # Débordement d'entier 64 bits : 21! > 2^63, le résultat ne doit pas être un entier négatif.
    r := math.factorial(21)
    check(r == null or r > 2432902008176640000, "factorial(21) ne doit pas déborder silencieusement (obtenu " + f"{r}" + ")")

