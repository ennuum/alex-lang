func t_non_finis():
    # inf / nan / très grands nombres : pas de blocage, résultats IEEE
    check_eq(math.sqrt(math.INF), math.INF, "sqrt(INF) = INF")
    check(math.isnan(math.sqrt(math.NAN)), "sqrt(NAN) est NAN")
    check_eq(math.cbrt(math.INF), math.INF, "cbrt(INF) = INF")
    check_eq(math.cbrt(0 - math.INF), 0 - math.INF, "cbrt(-INF) = -INF")
    check_eq(math.ln(math.INF), math.INF, "ln(INF) = INF")
    check_eq(math.log10(math.INF), math.INF, "log10(INF) = INF")
    check_eq(math.log2(math.INF), math.INF, "log2(INF) = INF")
    check(math.isnan(math.ln(math.NAN)), "ln(NAN) est NAN")
    check_eq(math.exp(math.INF), math.INF, "exp(INF) = INF")
    check_eq(math.exp(0 - math.INF), 0.0, "exp(-INF) = 0")
    check_eq(math.exp(1000000000.0), math.INF, "exp(1e9) = INF sans boucler")
    check_eq(math.exp(-1000000000.0), 0.0, "exp(-1e9) = 0 sans boucler")
    check(math.isnan(math.exp(math.NAN)), "exp(NAN) est NAN")
    check_eq(math.tanh(math.INF), 1.0, "tanh(INF) = 1")
    check_close(math.atan(math.INF), math.HALF_PI, 0.000000000000001, "atan(INF) = pi/2")
    check_eq(math.floor(math.INF), math.INF, "floor(INF) = INF")
    check_eq(math.ceil(0 - math.INF), 0 - math.INF, "ceil(-INF) = -INF")
    check(math.isnan(math.floor(math.NAN)), "floor(NAN) est NAN")
    check_eq(math.floor(10.0 ** 19), 10.0 ** 19, "floor(1e19) reste 1e19 (pas INT_MIN)")
    check_eq(math.ceil(0 - 10.0 ** 19), 0 - 10.0 ** 19, "ceil(-1e19) reste -1e19")
    check_eq(math.round(10.0 ** 300), 10.0 ** 300, "round(1e300) reste 1e300")
    check_eq(math.trunc(10.0 ** 19), 10.0 ** 19, "trunc(1e19) reste 1e19")
    check_eq(math.floor(9223372036854775807), 9223372036854775807, "floor(entier max) reste un entier")

