func t_lcm():
    check_eq(math.lcm(4, 6), 12, "lcm(4, 6)")
    check_type(math.lcm(4, 6), "int", "lcm(4, 6) est un int")
    check_eq(math.lcm(6, 4), 12, "lcm(6, 4)")
    check_type(math.lcm(6, 4), "int", "lcm(6, 4) est un int")
    check_eq(math.lcm(0, 5), 0, "lcm(0, 5)")
    check_type(math.lcm(0, 5), "int", "lcm(0, 5) est un int")
    check_eq(math.lcm(5, 0), 0, "lcm(5, 0)")
    check_type(math.lcm(5, 0), "int", "lcm(5, 0) est un int")
    check_eq(math.lcm(0, 0), 0, "lcm(0, 0)")
    check_type(math.lcm(0, 0), "int", "lcm(0, 0) est un int")
    check_eq(math.lcm(1, 7), 7, "lcm(1, 7)")
    check_type(math.lcm(1, 7), "int", "lcm(1, 7) est un int")
    check_eq(math.lcm(21, 6), 42, "lcm(21, 6)")
    check_type(math.lcm(21, 6), "int", "lcm(21, 6) est un int")
    check_eq(math.lcm(-4, 6), 12, "lcm(-4, 6)")
    check_type(math.lcm(-4, 6), "int", "lcm(-4, 6) est un int")
    check_eq(math.lcm(4, -6), 12, "lcm(4, -6)")
