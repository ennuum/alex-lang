# =============================================================================
# ALEX - suite de tests exhaustive du module stdlib/math/math.al
# =============================================================================
# Teste CHAQUE fonction publique et CHAQUE constante de math.al :
#   - valeurs typiques, cas limites, erreurs de domaine (retour null),
#   - types de retour (int / float / bool),
#   - régressions connues (grandes / petites valeurs, débordement d'entier).
#
# Les valeurs attendues proviennent d'une référence indépendante
# (module math de Python et arithmétique entière exacte).
#
# Lancer DEPUIS LA RACINE DU PROJET (le dossier stdlib/ est résolu
# relativement au dossier courant) :
#     ./alex run examples/math_test_suite.al
#
# Code de sortie : 0 si tout passe, 1 sinon (utilisable en CI).
# =============================================================================
use math
use core
use collections

TOL := 0.000000000001

stats := [0, 0]
notes := []
failed_funcs := []

func ok():
    stats[0] = stats[0] + 1

func fail(label, detail):
    stats[1] = stats[1] + 1
    collections.append(notes, f"{label} : {detail}")

func abs_val(v):
    if v < 0:
        return 0 - v
    return v

func check(cond, label):
    if cond:
        ok()
    else:
        fail(label, "condition fausse")

func check_eq(actual, expected, label):
    if actual == expected:
        ok()
    else:
        fail(label, f"obtenu {actual}, attendu {expected}")

func check_null(actual, label):
    if actual == null:
        ok()
    else:
        fail(label, f"obtenu {actual}, attendu null")

func check_type(actual, type_name, label):
    if core.type(actual) == type_name:
        ok()
    else:
        fail(label, f"type {core.type(actual)}, attendu {type_name}")

# Écart absolu tolérant, mis à l'échelle si |attendu| > 1.
func check_close(actual, expected, tol, label):
    if actual == null:
        fail(label, f"obtenu null, attendu {expected}")
    else:
        d := abs_val(actual - expected)
        scale := abs_val(expected)
        if scale < 1:
            scale = 1
        if d <= tol * scale:
            ok()
        else:
            fail(label, f"obtenu {actual}, attendu {expected} (écart {d})")

# Erreur relative pure (pour les résultats de grandeurs très variables).
func check_rel(actual, expected, tol, label):
    if actual == null:
        fail(label, f"obtenu null, attendu {expected}")
    else:
        d := abs_val(actual - expected)
        if d <= tol * abs_val(expected):
            ok()
        else:
            fail(label, f"obtenu {actual}, attendu {expected} (écart {d})")

func run(name, fn):
    before := stats[1]
    collections.clear(notes)
    try:
        fn()
    catch err:
        fail(name, f"exception inattendue : {err}")
    if stats[1] == before:
        print(f"  [OK]     {name}")
    else:
        print(f"  [ECHEC]  {name}")
        collections.append(failed_funcs, name)
        for msg in notes:
            print(f"           - {msg}")


func t_constantes():
    # PI, E, TAU, HALF_PI, LN2, LN10, EPSILON
    check_close(math.PI, 3.141592653589793, 0.00000000000000001, "PI")
    check_close(math.E, 2.718281828459045, 0.00000000000000001, "E")
    check_close(math.TAU, 6.283185307179586, 0.00000000000000001, "TAU")
    check_close(math.HALF_PI, 1.5707963267948966, 0.00000000000000001, "HALF_PI")
    check_close(math.LN2, 0.6931471805599453, 0.00000000000000001, "LN2")
    check_close(math.LN10, 2.302585092994046, 0.00000000000000001, "LN10")
    check_eq(math.EPSILON, 0.000000000001, "EPSILON")
    check_close(math.TAU, 2 * math.PI, 0.00000000000000001, "TAU = 2*PI")
    check_close(math.HALF_PI, math.PI / 2, 0.00000000000000001, "HALF_PI = PI/2")
    check_type(math.PI, "float", "PI est un float")
    check_eq(math.INF > 1000000.0, true, "INF est plus grand que tout")
    check_eq(math.NAN != math.NAN, true, "NAN != NAN")
    check_eq(math.INF == math.INF, true, "INF == INF")
    check_type(math.INF, "float", "INF est un float")

