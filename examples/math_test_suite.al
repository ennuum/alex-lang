    check(not math.isnan(1.5), "isnan(1.5) est faux")
    check(not math.isnan(0), "isnan(0) est faux")
    check(not math.isnan(math.INF), "isnan(INF) est faux")
    check(not math.isnan(-7), "isnan(-7) est faux")

func t_isinf():
    check(math.isinf(math.INF), "isinf(INF)")
    check(math.isinf(0 - math.INF), "isinf(-INF)")
